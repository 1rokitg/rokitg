{
  "mcpServers": {
    "multi-upload-tool": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://api.multi-upload-tool.com/mcp",
        "--header",
        "x-api-key:${MULTI_UPLOAD_API_KEY}"
      ]
    },
    "discord-mcp": {
      "url": "http://localhost:8085/mcp"
    }
  }
}
