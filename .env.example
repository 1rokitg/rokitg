# This file is a placeholder for environment variables required to run this project.
# Currently, there are no environment variables needed.

# Example of what future variables might look like:
# NEXT_PUBLIC_API_KEY=your_api_key_here
# DATABASE_URL=your_database_url_here
# SECRET_KEY=your_secret_key_here

# Password for protected pages/routes
PAGE_ACCESS_PASSWORD=password

# Password for the internal-only dashboard at /internal (separate from the
# marketing preview password above — gates real business data).
INTERNAL_DASHBOARD_PASSWORD=

# Whop API key (server-only). Used to create checkout configurations and to
# mint scoped Elements access tokens (e.g. for the /internal/events dashboard).
WHOP_API_KEY=

# Comma-separated IP addresses whose traffic should not load Whop tracking.
# Add your public IP here locally and in the Vercel Production environment.
WHOP_EXCLUDED_IPS=90.68.121.10,127.0.0.1,::1

# Privy app ID used by the /app waitlist login.
NEXT_PUBLIC_PRIVY_APP_ID=
